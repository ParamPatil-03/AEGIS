# Environment & Secret Credentials
.env
.env.*
!.env.example

# Python Bytecode & Caches
__pycache__/
*.py[cod]
*.pyc
.ruff_cache/
.pytest_cache/

# Development Scratch & Debug Scripts
scratch/
debug_scripts/

# System, Temp & IDE Files
.vscode/
.idea/
.DS_Store
*.tmp
tmp/
/tmp/

# Logs
*.log
logs/*
!logs/.gitkeep

# Large Raw & Processed Datasets
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
data/live_buffer*

# Heavy Trained Model Weights
models/**/*.json
models/**/*.pt
models/**/*.bin
models/*.json
models/*.pt
models/*.bin
!models/.gitkeep
!models/**/.gitkeep
